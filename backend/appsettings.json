{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EmergencyDb": ""
  },
  "Services": {
    "TransitBaseUrl": "",
    "TransitWarningPath": "api/transit/v1/disruptions/weather-notices"
