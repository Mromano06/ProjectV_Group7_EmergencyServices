{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RoleMapping": {
    "Manager": "emergency:Admin",
    "Dispatcher": "emergency:Dispatcher",
    "User": "emergency:Viewer"
  },
  "Registration": {
    "Issuer": "CmRegistrationService",
    "Audience": "CmRegistrationClients",
    "PublicKey": "",
    "SigningKey": ""
  },
  "ConnectionStrings": {
    "EmergencyDb": ""
  },
  "Services": {
    "GatewayBaseUrl": "",
    "TransitBaseUrl": "",
    "BudgetBaseUrl": "",
    "HrBaseUrl": "",
    "TransitWarningPath": "api/transit/v1/disruptions/weather-notices",
    "TransitEmergencyIncidentPath": "api/transport/v1/integrations/emergency/incidents",
    "TransitIncidentRadiusMeters": 250,
    "RoadClosuresPath": "api/transport/v1/road-closures"
  },
  "WarningSimulator": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "ChanceOfNewWarning": 0.25,
    "KeepAtLeastOneActive": true,
    "MaxActiveSimulated": 3
  }
}

